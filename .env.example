# ==============================================================================
# TrustVault Environment Configuration Template
# DO NOT put real secrets in this file. Copy this file to .env for local use.
# ==============================================================================

# Application Profile (e.g. dev, prod)
SPRING_PROFILES_ACTIVE=dev

# Server Port (Render sets PORT automatically, defaults to 8080 locally)
PORT=8080

# Database Configuration (PostgreSQL / Supabase)
# For Direct Connection or Supabase Session/Transaction Pooler:
# e.g. jdbc:postgresql://aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://db.fjtegicvsdggajprxjdi.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password_here

# Supabase Storage Configuration
# Project Reference: fjtegicvsdggajprxjdi
SUPABASE_URL=https://fjtegicvsdggajprxjdi.supabase.co
# Backend service role key for private storage operations (KEEP SECRET)
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here
# Name of the private storage bucket
SUPABASE_STORAGE_BUCKET=trustvault-documents

# Security Settings
# In production on Render (HTTPS), set to true. For local http, set to false.
SESSION_COOKIE_SECURE=false

# Demo & Bootstrap Admin Credentials
APP_ADMIN_EMAIL=admin@trustvault.local
APP_ADMIN_PASSWORD=ChangeMePromptly123!
